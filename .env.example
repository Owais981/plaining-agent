# Copy this file to .env and fill in real values. Never commit .env.

# --- Data layer ---
DATABASE_URL=postgresql+psycopg://planning:planning@localhost:5432/planning_agent
REDIS_URL=redis://localhost:6379/0
CELERY_ENABLED=false

# --- LLM (conversational agent) ---
# Without this key set, every REST endpoint (CRUD, optimize, conflicts,
# costs, risks, approval) still works -- only /api/v1/conversations/* is
# disabled (returns 503 AI_NOT_CONFIGURED).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Routing ---
# ROUTING_PROVIDER: haversine | osrm | google
# Defaults to haversine (straight-line + road-winding-factor estimate,
# always labeled data_source=haversine_estimate) when no provider is
# configured -- never crashes, never silently returns fake "measured" data.
ROUTING_PROVIDER=haversine
OSRM_BASE_URL=
GOOGLE_MAPS_API_KEY=
MAPBOX_TOKEN=
ROAD_WINDING_FACTOR=1.3
AVERAGE_SPEED_KMH=55

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# --- Solver ---
SOLVER_MAX_SECONDS=120
SOLVER_WORKERS=8
SOLVER_RELATIVE_GAP=0.02
SOLVER_SEED=42

# --- Misc ---
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173
